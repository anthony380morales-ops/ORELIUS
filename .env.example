# Database Configuration
DATABASE_URL=postgresql://oreilus_user:your_password_here@localhost:5432/oreilus
REDIS_URL=redis://localhost:6379/0

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_FILE=./google-credentials.json
GOOGLE_SHEET_ID_TRENDS=your-trends-sheet-id
GOOGLE_SHEET_ID_BANKING=your-banking-sheet-id

# Social Media APIs (Phase 3+)
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
FACEBOOK_ACCESS_TOKEN=your_facebook_token
LINKEDIN_ACCESS_TOKEN=your_linkedin_token
X_BEARER_TOKEN=your_x_bearer_token
TIKTOK_SESSION_ID=your_tiktok_session

# Security
JWT_SECRET_KEY=your-random-secret-key-generate-with-openssl
ENCRYPTION_KEY=your-encryption-key-32-bytes
MASTER_PASSWORD=your-master-password

# System Configuration
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === Autonomous ecosystem orchestration (multi-agent social growth engine) ===
# Run mode — SAFETY DEFAULT is simulation (no real messages/publishing/spend).
# Values: simulation | dry_run | live
SOCIAL_AUTOMATION_MODE=simulation
SOCIAL_DAILY_TOUCHPOINT_TARGET=1050
SOCIAL_DAILY_BUDGET_USD=25
IBC_TOUCHPOINT_BASELINE=600
NXG_TOUCHPOINT_BASELINE=430

# Kill switches (durable overrides live in the system_flags table; these are boot defaults)
SYSTEM_PAUSE=false
MESSAGING_PAUSE=false
PUBLISHING_PAUSE=false
OUTBOUND_PAUSE=false
NXG_PAUSE=false
IBC_PAUSE=false
HIGGBOT_PAUSE=false
ATHENA_PAUSE=false

# ATHENA (social operations) — runs on the owner's machine
ATHENA_BASE_URL=http://127.0.0.1:8787
ATHENA_API_TOKEN=

# HIGGBOT (creative engine) — MCP stdio; simulation mode runs with no keys
HIGGBOT_MCP_PATH=
HIGGBOT_API_URL=

# LUCIUS (owner interface)
LUCIUS_BASE_URL=
LUCIUS_API_TOKEN=

# Manychat (conversational edge — comment-to-DM, story replies, keyword flows)
MANYCHAT_API_TOKEN=
MANYCHAT_BASE_URL=https://api.manychat.com

# n8n (workflow glue — webhooks, notifications, integrations; NOT the brain)
N8N_BASE_URL=
N8N_API_TOKEN=

# Meta Graph API (Instagram / Facebook)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
